# ──────────────────────────────────────────────
# LiveKit Server — Plantilla
# ──────────────────────────────────────────────
# Renderizada por scripts/setup-lan.sh → infra/livekit/livekit.yaml
# No editar el .yaml generado: se sobrescribe en cada corrida.

port: 7880
rtc:
  # IP del host en la red local — imprescindible para el ICE de los medios
  node_ip: ${HOST_IP}
  port_range_start: 50000
  port_range_end: 50060
  tcp_port: 7881
  use_external_ip: false

redis:
  address: redis:6379

keys:
  ${LIVEKIT_API_KEY}: ${LIVEKIT_API_SECRET}

room:
  empty_timeout: 300  # 5 minutos
  max_participants: 50

webhook:
  urls:
    - http://host.docker.internal:${API_PORT}/api/webhooks/livekit
  api_key: ${LIVEKIT_API_KEY}

logging:
  level: info
