{
	debug
}

# Subdominio oficial
poc.jscomunicadores.com {
	# Redirigir llamadas de API directamente al backend Elysia
	handle /api/* {
		reverse_proxy host.docker.internal:3000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Frontend compilado (Vite preview o servidor estático)
	handle {
		reverse_proxy host.docker.internal:5173 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
}

# LiveKit WSS
poc.jscomunicadores.com:7443 {
	reverse_proxy livekit:7880 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}
}
